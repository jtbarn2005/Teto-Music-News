<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:background="@color/teto_surface">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:padding="20dp" android:background="@color/teto_cyan" android:orientation="vertical">
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="KASANE TETO" android:textColor="@color/white" android:textStyle="bold" android:textSize="13sp" android:letterSpacing="0.16" />
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Music News" android:textColor="@color/white" android:textStyle="bold" android:textSize="30sp" />
        <TextView android:id="@+id/statusText" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="5dp" android:text="Latest uploads from the last 7 days" android:textColor="@color/white" android:textSize="14sp" />
    </LinearLayout>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:padding="12dp" android:gravity="center_vertical">
        <Button android:id="@+id/refreshButton" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Refresh" android:textColor="@color/teto_dark_cyan" />
        <Space android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="1" />
        <Button android:id="@+id/popularButton" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="This month" android:textColor="@color/teto_pink" />
    </LinearLayout>
    <TextView android:id="@+id/emptyText" android:layout_width="match_parent" android:layout_height="wrap_content" android:padding="24dp" android:gravity="center" android:textColor="@color/teto_muted" android:textSize="15sp" android:visibility="gone" />
    <androidx.recyclerview.widget.RecyclerView android:id="@+id/videoList" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:padding="12dp" android:clipToPadding="false" />
</LinearLayout>
