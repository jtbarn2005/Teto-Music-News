<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="12dp" app:cardCornerRadius="16dp" app:cardElevation="2dp" xmlns:app="http://schemas.android.com/apk/res-auto">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
        <ImageView android:id="@+id/thumbnail" android:layout_width="match_parent" android:layout_height="190dp" android:scaleType="centerCrop" android:src="@drawable/teto_placeholder" android:contentDescription="Video thumbnail" />
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:padding="14dp" android:orientation="vertical">
            <TextView android:id="@+id/title" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="@color/teto_ink" android:textStyle="bold" android:textSize="17sp" android:maxLines="2" />
            <TextView android:id="@+id/meta" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:textColor="@color/teto_muted" android:textSize="13sp" />
            <TextView android:id="@+id/description" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:textColor="@color/teto_muted" android:textSize="13sp" android:maxLines="2" />
        </LinearLayout>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
